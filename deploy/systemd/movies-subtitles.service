[Unit]
Description=Movies subtitle proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/movies-api
EnvironmentFile=/var/www/movies-api/.env
ExecStart=/usr/bin/node /var/www/movies-api/subtitles.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
